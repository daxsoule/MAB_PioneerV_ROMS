# Literature — never commit external publisher PDFs (see literature/README.md)
# This ONLY blocks files under literature/. Generated artifacts under
# outputs/ are deliberately allowed: they are reproducible from version-
# controlled scripts and are not subject to publisher licensing.
literature/**/*.pdf
literature/**/*.epub
literature/**/*.djvu

# Python / Jupyter cruft
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.ipynb_checkpoints/
.venv/
.DS_Store

# Large data caches — keep raw downloads and processed slices out of git
# (matches files in outputs/data/ and any subdir like raw/, processed/)
outputs/data/**/*.nc
outputs/data/**/*.zarr
outputs/data/**/*.parquet
outputs/data/**/*.pdf

# Methods / review docs kept local-only (not pushed to public repo).
# The constitution PDF + its source md remain tracked intentionally.
outputs/docs/methods_*.md
outputs/docs/methods_*.pdf
